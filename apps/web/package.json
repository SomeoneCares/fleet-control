{
  "name": "fleetcontrol-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/tokens.mjs --check",
    "dev": "npm run tokens && vite",
